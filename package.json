{
  "name": "grats",
  "version": "0.0.37",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": "bin/grats.js",
  "types": "dist/src/index.d.ts",
  "license": "MIT",
  "files": [
    "bin",
    "dist/src/index.js",
    "dist/src/index.d.ts",
    "dist/src/Types.js",
    "dist/src/Types.d.ts",
    "llm-docs"
  ],
  "scripts": {
    "test": "tsx src/tests/test.ts",
    "test-example-projects": "node src/tests/testExampleProjects.mjs",
    "build": "pnpm run build:binary && pnpm run build:js",
    "build:binary": "tsx scripts/buildBinary.ts",
    "build:js": "rm -rf dist/ && tsc --build",
    "build:wasm": "cd grats-rs && cargo build --release --target wasm32-unknown-unknown --package grats_wasm",
    "test:wasm": "pnpm run build:wasm && node --import tsx --test website/src/wasm/grats.test.ts",
    "format": "prettier . --write",
    "lint": "eslint . && prettier . --check",
    "profile": "tsx scripts/profile.ts"
  },
  "dependencies": {
    "graphql": "^16.11.0"
  },
  "peerDependencies": {
    "typescript": ">=5.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "commander": "^14.0.1",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jest-diff": "^30.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.19.0",
    "typescript": "5.9.2"
  },
  "prettier": {
    "trailingComma": "all"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20 <=24"
  },
  "bugs": {
    "url": "https://github.com/captbaritone/grats/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/captbaritone/grats.git"
  },
  "author": {
    "name": "Jordan Eldredge",
    "email": "jordan@jordaneldredge.com",
    "url": "https://jordaneldredge.com"
  },
  "keywords": [
    "graphql",
    "typescript",
    "resolvers",
    "schema",
    "code-first",
    "implementation-first"
  ]
}
